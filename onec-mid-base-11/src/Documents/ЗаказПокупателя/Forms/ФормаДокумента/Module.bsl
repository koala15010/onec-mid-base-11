#Область СлужебныеПроцедурыИФункции

// {{ КЛ_НАЧАЛО ДОРАБОТКИ: Логика расчета скидки
&НаКлиенте
Процедура КЛ_СогласованнаяСкидкаПриИзменении(Элемент)
	
	// Если таблицы пустые, вопрос не задаем и сразу выходим
	Если Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросОПересчете", ЭтотОбъект);
	ТекстВопроса = "Пересчитать суммы в табличной части с учетом новой скидки?";
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОПересчете(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		КЛ_ПересчитатьТаблицыНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

// Обработчик нажатия программной кнопки
&НаКлиенте
Процедура КЛ_ПересчитатьТаблицуНажатиеКнопки(Команда)
	
	КЛ_ПересчитатьТаблицыНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура КЛ_ПересчитатьТаблицыНаКлиенте()
	
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(СтрокаТЧ); 
	КонецЦикла;
	
	Для Каждого СтрокаТЧ Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(СтрокаТЧ); 
	КонецЦикла;
	
КонецПроцедуры
// }} КЛ_КОНЕЦ ДОРАБОТКИ

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//Оригинальный код процедуры до доработки
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
	// {{ КЛ_НАЧАЛО ДОРАБОТКИ: Расчет с учетом двух скидок
	
	// 1. Получаем процент скидки из строки ТЧ
	ПроцентСкидкиТЧ = ТекущиеДанные.Скидка;
	
	// 2. Получаем процент согласованной скидки из шапки
	ПроцентСкидкиШапки = 0;
	Если ЗначениеЗаполнено(Объект.КЛ_СогласованнаяСкидка) Тогда
		ПроцентСкидкиШапки = Объект.КЛ_СогласованнаяСкидка;
	КонецЕсли;
	
	// 3. Суммируем обе скидки
	ОбщийПроцентСкидки = ПроцентСкидкиТЧ + ПроцентСкидкиШапки;
	
	// 4. Ограничиваем общую скидку, чтобы она не превышала 100%
	Если ОбщийПроцентСкидки > 100 Тогда
		ОбщийПроцентСкидки = 100;
        ПоказатьПредупреждение(, "Суммарный процент скидки не может превышать 100%. Установлено максимальное значение.");
	КонецЕсли;
	
	// 5. Рассчитываем итоговую сумму строки от базовой стоимости
	ВсегоБезСкидки = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
	ТекущиеДанные.Сумма = ВсегоБезСкидки * (1 - ОбщийПроцентСкидки / 100);
	
	РассчитатьСуммуДокумента();
	
	// }} КЛ_КОНЕЦ ДОРАБОТКИ
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

