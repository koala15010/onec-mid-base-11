Процедура ВывестиКонтактноеЛицоДокумента(Форма, ИмяЭлементаДоговора) Экспорт
	
    Элементы = Форма.Элементы;
	ЭлементДоговор = Элементы.Найти(ИмяЭлементаДоговора);
	
	Если ЭлементДоговор <> Неопределено И Элементы.Найти("КЛ_КонтактноеЛицо") = Неопределено Тогда 
		
		РодительПоля = ЭлементДоговор.Родитель;
		
		// Находим индекс Договора в группе
		ИндексДоговора = РодительПоля.ПодчиненныеЭлементы.Индекс(ЭлементДоговор);
		КоличествоЭлементов = РодительПоля.ПодчиненныеЭлементы.Количество();
		
		// Если после договора есть другие элементы, вставляем ПЕРЕД следующим элементом
		Если ИндексДоговора < КоличествоЭлементов - 1 Тогда
			ЭлементПослеДоговора = РодительПоля.ПодчиненныеЭлементы[ИндексДоговора + 1];
			НовоеПоле = Элементы.Вставить("КЛ_КонтактноеЛицо", Тип("ПолеФормы"), РодительПоля, ЭлементПослеДоговора);
		Иначе
			// Если договор последний в группе, просто добавляем в конец группы
			НовоеПоле = Элементы.Добавить("КЛ_КонтактноеЛицо", Тип("ПолеФормы"), РодительПоля);
		КонецЕсли;
		
		НовоеПоле.Вид = ВидПоляФормы.ПолеВвода;
		НовоеПоле.ПутьКДанным = "Объект.КЛ_КонтактноеЛицо";
		НовоеПоле.Заголовок = "Контактное лицо";
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиСогласованнуюСкидку(Форма, ИмяЭлементаПривязки) Экспорт

	Элементы = Форма.Элементы;
	
	РодительЛево = Элементы.Найти("ГруппаШапкаЛево");
	
	Если РодительЛево <> Неопределено И Элементы.Найти("КЛ_ГруппаСкидки") = Неопределено Тогда
		
		// 1. Создаем горизонтальную группу для размещения элементов в одну строку
		ГруппаСкидки = Элементы.Добавить("КЛ_ГруппаСкидки", Тип("ГруппаФормы"), РодительЛево);
		ГруппаСкидки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаСкидки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		ГруппаСкидки.ОтображатьЗаголовок = Ложь;
		ГруппаСкидки.РастягиватьПоГоризонтали = Ложь;
		
		// Перемещаем группу в самый конец ГруппаШапкаЛево
		Элементы.Переместить(ГруппаСкидки, РодительЛево, Неопределено);
		
		// 2. Создаем поле ввода скидки внутри нашей новой группы
		НовоеПоле = Элементы.Добавить("КЛ_СогласованнаяСкидка", Тип("ПолеФормы"), ГруппаСкидки);
		НовоеПоле.Вид = ВидПоляФормы.ПолеВвода;
		НовоеПоле.ПутьКДанным = "Объект.КЛ_СогласованнаяСкидка";
		НовоеПоле.Заголовок = "Скидка, %";
		НовоеПоле.Ширина = 10;
		
		// Настройка ограничения ввода до 100
		НовоеПоле.МаксимальноеЗначение = 100;
		НовоеПоле.МинимальноеЗначение  = 0;
		
		НовоеПоле.УстановитьДействие("ПриИзменении", "КЛ_СогласованнаяСкидкаПриИзменении");
		
		// 3. Создаем программную команду для кнопки
		ИмяКоманды = "КЛ_ПересчитатьТаблицуКоманда";
		Если Форма.Команды.Найти(ИмяКоманды) = Неопределено Тогда
			НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
			НоваяКоманда.Действие = "КЛ_ПересчитатьТаблицуНажатиеКнопки";
			НоваяКоманда.Заголовок = "Пересчитать скидку";
		КонецЕсли;
		
		// 4. Размещаем кнопку в той же группе справа от поля
		НоваяКнопка = Элементы.Добавить("КЛ_КнопкаПересчета", Тип("КнопкаФормы"), ГруппаСкидки);
		НоваяКнопка.ИмяКоманды = ИмяКоманды;
		
	КонецЕсли;

КонецПроцедуры